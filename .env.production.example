# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION — AI PROGRAMMING LAB
# ==============================================================================

# Server Domain & Environment
DOMAIN=lab.yourdomain.com
NODE_ENV=production
APP_ENV=production
PORT=3000

# Security Secrets (Must be changed in production!)
# Generate via: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
JWT_EXPIRES_IN=1d

# MongoDB Production Authentication
# If using internal Docker MongoDB:
MONGO_ROOT_USER=labadmin
MONGO_ROOT_PASSWORD=replace_with_a_secure_mongo_password
MONGODB_URI=mongodb://labadmin:replace_with_a_secure_mongo_password@mongodb:27017/ai-lab?authSource=admin
MONGODB_DB_NAME=ai-lab
# If using MongoDB Atlas, uncomment and provide Atlas URI:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ai-lab

# Redis Queue & Cache Authentication
REDIS_PASSWORD=replace_with_a_secure_redis_password
REDIS_URL=redis://redis:6379

# Inter-service URLs (Docker internal network)
AI_SERVICE_URL=http://ai-service:8000
CORS_ORIGIN=https://lab.yourdomain.com

# Python AI Service & OpenAI Configuration
OPENAI_API_KEY=sk-your-production-openai-api-key
AI_MOCK_MODE=false
AI_ANALYSIS_MODEL=gpt-4o-mini
AI_QUIZ_MODEL=gpt-4o-mini
AI_REPORT_MODEL=gpt-4o
AI_LEARNING_PATH_MODEL=gpt-4o-mini

# Frontend API Path
VITE_API_URL=/api
