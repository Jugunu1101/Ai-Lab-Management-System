# ==============================================================================
# AI-Powered Programming Lab Management Platform — Environment Template
# Copy this file to .env and customize with your own secrets.
# ==============================================================================

# --- Node.js Backend Configuration ---
PORT=3000
NODE_ENV=development

# --- Database Selection (Choose LOCAL for offline dev or ATLAS for cloud) ---
# Option A: Local MongoDB (Offline & Local Development — Default)
MONGODB_URI=mongodb://localhost:27017/ai-lab

# Option B: Remote MongoDB Atlas (Cloud Production — Requires Internet)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

MONGODB_DB_NAME=ai-lab
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret

JWT_EXPIRES_IN=1d
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=*
DISABLE_RATE_LIMIT=false
DEFAULT_SEED_PASSWORD=Password@123
GLOBAL_RATE_LIMIT=10000
AUTH_RATE_LIMIT=5000

# --- Python AI Service Configuration ---
APP_NAME="Programming Lab AI Service"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
AI_PROVIDER=gemini
AI_MOCK_MODE=true
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_BASE_URL=
AI_ANALYSIS_MODEL=gemini-3.1-flash-lite
AI_QUIZ_MODEL=gemini-3.1-flash-lite
AI_REPORT_MODEL=gemini-3.1-flash-lite
AI_LEARNING_PATH_MODEL=gemini-3.1-flash-lite
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=2
AI_RATE_LIMIT=30
AI_RATE_WINDOW_SECONDS=60

# --- React Frontend Configuration ---
VITE_API_URL=/api
