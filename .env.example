# ==============================================================================
# AI-Powered Programming Lab Management Platform — Environment Configuration
# ==============================================================================

# Node.js Backend Configuration
PORT=3000
MONGODB_URI=mongodb://mongodb:27017/programming_lab
MONGODB_DB_NAME=ai-lab
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
JWT_EXPIRES_IN=1d
REDIS_URL=redis://redis:6379
AI_SERVICE_URL=http://ai-service:8000
CORS_ORIGIN=*

# Python AI Service Configuration
OPENAI_API_KEY=
AI_MOCK_MODE=true
AI_ANALYSIS_MODEL=gpt-4o-mini
AI_QUIZ_MODEL=gpt-4o-mini
AI_REPORT_MODEL=gpt-4o
AI_LEARNING_PATH_MODEL=gpt-4o-mini

# React Frontend Configuration
VITE_API_URL=/api
