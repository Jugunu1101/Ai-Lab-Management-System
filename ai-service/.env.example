APP_NAME=Programming Lab AI Service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# AI Provider: gemini, openai, or auto
AI_PROVIDER=gemini
AI_MOCK_MODE=false

# For Google AI Studio (Gemini):
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# For OpenAI:
OPENAI_API_KEY=your_openai_api_key_here

# Models (e.g. gemini-3.6-flash, gemini-flash-latest, or gpt-4o-mini)
AI_ANALYSIS_MODEL=gemini-3.6-flash
AI_QUIZ_MODEL=gemini-3.6-flash
AI_REPORT_MODEL=gemini-3.6-flash
AI_LEARNING_PATH_MODEL=gemini-3.6-flash